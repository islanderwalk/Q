  {
   "type": "stat",
   "title": "上一輪結果",
   "id": 5,
   "datasource": {
    "type": "prometheus",
    "uid": "q3_prom"
   },
   "description": "ok＝完整；partial＝有單篇失敗或沒讀完，下一輪自動補；gate_blocked＝品質檢查擋下；rolled_back＝整輪還原；failed＝程式錯誤或連續兩批寫不進去，這輪先停、下一輪補。",
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 16,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "q3_prom"
     },
     "expr": "max by (status) (q3_run_status) == 1",
     "legendFormat": "{{status}}",
     "refId": "A",
     "range": false,
     "instant": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "q3_prom"
     },
     "expr": "vector(1) unless on() count(q3_run_status)",
     "legendFormat": "第一輪還在跑",
     "refId": "B",
     "range": false,
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#2e9e5b",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "partial"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#e8833a"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "gate_blocked"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#e8833a"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "rolled_back"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#e8833a"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "failed"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#d64545"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "第一輪還在跑"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#8a8f98"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "name",
    "justifyMode": "center",
    "orientation": "auto",
    "wideLayout": true,
    "showPercentChange": false
