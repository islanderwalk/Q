  {
   "type": "stat",
   "title": "新文章多久可搜尋：最久等待（分鐘）",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "q3_prom"
   },
   "description": "列表上已出現、還沒入庫的 7 天內文章裡，發文最久的那篇等了幾分鐘（上次算出的值加上算完到現在的時間）。規格 1：6 小時（360 分鐘）內要能搜尋；超過 180 分鐘（3 小時）就告警，留 3 小時處理。橘＝已告警，紅＝規格已破。",
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "q3_prom"
     },
     "expr": "max((q3_unsearchable_oldest_minutes > 0) + (time() - q3_window_stats_timestamp_seconds) / 60) or max(q3_unsearchable_oldest_minutes)",
     "legendFormat": "",
     "refId": "A",
     "range": true,
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "m",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#2e9e5b",
        "value": null
       },
       {
        "color": "#e8833a",
        "value": 180
       },
       {
        "color": "#d64545",
        "value": 360
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center",
    "orientation": "auto",
    "wideLayout": true,
    "showPercentChange": false
   }
  },
