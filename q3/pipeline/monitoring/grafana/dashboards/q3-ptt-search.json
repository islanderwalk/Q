   "id": 4,
   "datasource": {
    "type": "prometheus",
    "uid": "q3_prom"
   },
   "description": "從最新列表頁沿「上頁」走到 7 天前：要走完、走的途中最新頁沒變、列表上該在的文章都已入庫且是正常狀態。列表頁不是 20 格、時間戳倒序只記在明細，不算失敗。",
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 12,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "q3_prom"
     },
     "expr": "max(q3_verify_ok) and on() (max(q3_verify_last_run_timestamp_seconds) > 0)",
     "legendFormat": "",
     "refId": "A",
     "range": true,
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#8a8f98",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "noValue": "還沒跑：第一輪結束後跑第一次",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "失敗",
         "color": "#d64545"
        },
        "1": {
         "text": "通過",
         "color": "#2e9e5b"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
