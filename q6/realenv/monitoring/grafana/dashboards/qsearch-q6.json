    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "histogram_quantile(0.95, sum by (le, seg) (rate(wordcloud_duration_seconds_bucket{cache=\"miss\"}[1m])))",
     "legendFormat": "p95 {{seg}}",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "histogram_quantile(0.5, sum by (le, seg) (rate(wordcloud_duration_seconds_bucket{cache=\"miss\"}[1m])))",
