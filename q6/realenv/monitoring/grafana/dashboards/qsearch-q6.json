   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "pg"
     },
     "rawSql": "SELECT date_trunc('second', at) AS time, sum(docs)::float / 1 AS docs_per_s FROM backfill_batches WHERE $__timeFilter(at) GROUP BY 1 ORDER BY 1",
