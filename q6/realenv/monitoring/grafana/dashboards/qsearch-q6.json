   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "pg"
     },
     "rawSql": "SELECT partition_id AS 分區, status AS 狀態, raw_count AS 原文, written AS 寫入, checkpoint_line AS checkpoint, docs_per_sec AS 每秒, (gates->'G2'->>'pass') AS G2洩漏, (gates->'G3'->>'canary_p95_ms_after') AS 探針p95ms FROM backfill_ledger WHERE finished_at IS NOT NULL ORDER BY finished_at DESC LIMIT 12",
