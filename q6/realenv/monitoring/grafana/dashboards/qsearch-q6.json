    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "pg"
     },
     "rawSql": "SELECT status AS 狀態, count(*) AS 分區數, sum(written) AS 已寫入, sum(noop) AS 未變更 FROM backfill_ledger GROUP BY status ORDER BY 1",
