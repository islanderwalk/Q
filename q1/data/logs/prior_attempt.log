# 顧客信的問題描述句：去掉否定前綴「…，但是」後有幾種說法
$ <tmp>/venv/bin/python -I -B -c 'import json, sys
from collections import Counter
c, n = Counter(), 0
for line in open(sys.argv[1], encoding="utf-8"):
    t = json.loads(line)
    if t["kind"] != "customer":
        continue
    n += 1
    c.update(s.split("，但是", 1)[-1] for s in t.get("issue_lines", []))
print(f"customers={n:,} issue_sentences={sum(c.values()):,} distinct_after_negation_prefix={len(c)} repeat_min={min(c.values())} repeat_max={max(c.values())}")' fx_small/emails_truth.jsonl
customers=1,986 issue_sentences=2,358 distinct_after_negation_prefix=43 repeat_min=30 repeat_max=96
exit=0

