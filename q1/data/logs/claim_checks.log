# 產生器期望值的同分程度（精確列舉）
$ PYTHONDONTWRITEBYTECODE=1 <tmp>/venv/bin/python -c '
import sys; sys.path.insert(0, "q1/code"); import make_fixtures as mf
e50, e80 = mf.expected_survey_shares(0.5), mf.expected_survey_shares(0.8)
g50 = [e50[i] for i in ("登入與帳號", "介面與操作", "閃退與當機")]; g80 = [e80[i] for i in ("速度與效能", "匯出與報表", "閃退與當機")]
print("0.50 login/ui/crash", [round(100*x, 3) for x in g50], "spread pp", round(100*(max(g50)-min(g50)), 3))
print("0.80 speed/export/crash", [round(100*x, 3) for x in g80], "spread pp", round(100*(max(g80)-min(g80)), 3))
print("0.50 speed", round(100*e50["速度與效能"], 3), "3rd expected", round(100*sorted(e50.values())[-3], 3), "gap", round(100*(sorted(e50.values())[-3]-e50["速度與效能"]), 3))'
